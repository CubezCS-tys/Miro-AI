# Copy to .env and fill in
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model/provider defaults
MIRO_AI_PROVIDER=gemini
MIRO_AI_FALLBACK_PROVIDER=
MIRO_AI_EXTRACTION_MODEL=gemini-3.1-pro-preview
MIRO_AI_LIGHT_MODEL=gemini-3.1-flash-lite
# Set MIRO_AI_FALLBACK_PROVIDER=anthropic only if ANTHROPIC_API_KEY is filled.
# MIRO_AI_ANTHROPIC_MODEL=claude-opus-4-8

# Cost and safety controls
MIRO_AI_CACHE_ENABLED=true
MIRO_AI_LLM_RPM=30
MIRO_AI_LLM_RETRIES=2
MIRO_AI_LLM_TIMEOUT_MS=60000
MIRO_AI_MAX_UPLOAD_BYTES=26214400
MIRO_AI_MAX_PROMPT_CHARS=12000
MIRO_AI_MAX_CODE_CHARS=20000
MIRO_AI_ENABLE_SERVER_EXECUTION=false
MIRO_AI_ENABLE_LIVE_RESEARCH=false
